# Copy to .env and fill in. Works with local PostgreSQL or Neon.

# Neon example - paste your Neon connection string (keep ?sslmode=require), then:
#   npm run migrate && npm run seed
#   DATABASE_URL=postgresql://neondb_owner:npg_0WmgFIE7UnXv@ep-flat-tree-b58wua47.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=postgres://dwp:dwp_local_dev_pw@127.0.0.1:5432/dwp

PORT=3000
PUBLIC_URL=http://localhost:3000
UPLOAD_DIR=uploads

JWT_SECRET=generate-a-long-random-string
JWT_TTL=7d
RESET_TTL_MINUTES=60

ADMIN_EMAILS=you@example.com
CONTACT_EMAIL=you@example.com

# Cloudinary (optional) - deposit proof storage; falls back to local disk when unset.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Resend (optional) - OTP verification + transactional email.
# Without RESEND_API_KEY emails are printed to the server console instead.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM="Digital Wealth Partners <onboarding@resend.dev>"
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
