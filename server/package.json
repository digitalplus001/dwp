{
  "name": "dwp-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express + PostgreSQL (Neon-compatible) backend for Digital Wealth Partners",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:prod": "node src/db/migrate.js && node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "node test/api.test.js",
    "reset": "node src/db/migrate.js --reset && node src/db/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pg": "^8.13.1",
    "ws": "^8.22.0"
  }
}
